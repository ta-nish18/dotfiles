!.gitignore

# OS / editor generated files
.DS_Store
.viminfo
*.swp
*.swo
*~

# Shell history and machine-local Git identity
.zsh_history
.bash_history
.gitconfig

# Environment variables and credentials
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Local caches and generated files
__pycache__/
*.pyc
